{
     "builds": [
        {
            "src": "myinfo/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "15mb" , "runtime": "python3.9"
            }
        }],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "myinfo/wsgi.py"
        }
    ]
}